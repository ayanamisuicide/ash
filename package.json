{
  "name": "probot-style-bot",
  "version": "3.4.1",
  "description": "Discord-бот в стиле ProBot: модерация, логирование, веб-панель модератора",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "predev": "node scripts/stop-bot.mjs",
    "dev": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/index.ts",
    "launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1",
    "launch:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1 -Dev",
    "launch:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1 -ChecksOnly -SkipDeploy -NoNewWindow -NoBanner",
    "launch:live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1 -StartFirst -NoNewWindow",
    "stop": "node scripts/stop-bot.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && npm run build:panel && npm run copy-assets",
    "build:panel": "node scripts/build-panel.mjs",
    "copy-assets": "node scripts/copy-assets.mjs",
    "prestart": "node scripts/stop-bot.mjs",
    "start": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "lint": "eslint src tests scripts web/src --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"web/src/**/*.{ts,tsx,css}\" \"*.{json,md,yml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"web/src/**/*.{ts,tsx,css}\" \"*.{json,md,yml}\"",
    "test": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --test tests/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --test-coverage-lines=57 --test-coverage-branches=77 --test-coverage-functions=73 --import=tsx --test \"tests/*.test.ts\"",
    "test:panel": "npm --prefix web run test",
    "test:panel:coverage": "npm --prefix web run test:coverage",
    "verify": "node scripts/verify.mjs",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run test:panel:coverage && npm run build",
    "health": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning node scripts/healthcheck.mjs",
    "restore": "node scripts/restore.mjs",
    "tunnel": "node scripts/tailscale.mjs",
    "deploy": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/deploy-commands.ts",
    "release:github": "node scripts/release-gh.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  }
}
