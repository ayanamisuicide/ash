# Токен бота (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# Application ID (Developer Portal -> General Information -> Application ID)
DISCORD_CLIENT_ID=

# Необязательно: ID сервера для мгновенной регистрации команд
# (без него команды обновляются глобально до 1 часа)
GUILD_ID=

# Необязательно: путь к SQLite-базе (по умолчанию data/bot.sqlite)
# DB_FILE=./data/bot.sqlite

# Необязательно: старый JSON для одноразовой миграции (по умолчанию data/data.json)
# DATA_FILE=./data/data.json

# Авто-бэкапы SQLite: интервал в часах (0 — выключить) и сколько копий хранить
# DB_BACKUP_INTERVAL_HOURS=6
# DB_BACKUP_KEEP=7
# DB_BACKUP_DIR=./data/backups

# Заготовка веб-панели (пока только /api/status)
WEB_ENABLED=false
WEB_PORT=3000
WEB_HOST=127.0.0.1
