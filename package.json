{
  "name": "probot-style-bot",
  "version": "2.0.0",
  "description": "Discord-бот в стиле ProBot: модерация, логирование, заготовка под веб-панель",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,yml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,yml}\"",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --test tests/*.test.ts",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "health": "NODE_OPTIONS=--disable-warning=ExperimentalWarning node scripts/healthcheck.mjs",
    "restore": "node scripts/restore.mjs",
    "deploy": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/deploy-commands.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  }
}
