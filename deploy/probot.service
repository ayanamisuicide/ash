[Unit]
Description=Probot-style Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=probot
Group=probot
WorkingDirectory=/opt/probot
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--disable-warning=ExperimentalWarning
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/probot/data

[Install]
WantedBy=multi-user.target
