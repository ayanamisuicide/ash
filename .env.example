# Токен бота (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# Application ID (Developer Portal -> General Information -> Application ID)
DISCORD_CLIENT_ID=

# Необязательно: ID сервера для мгновенной регистрации команд
# (без него команды обновляются глобально до 1 часа)
GUILD_ID=

# Необязательно: путь к SQLite-базе (по умолчанию data/bot.sqlite)
# DB_FILE=./data/bot.sqlite

# Необязательно: старый JSON для одноразовой миграции (по умолчанию data/data.json)
# DATA_FILE=./data/data.json

# Авто-бэкапы SQLite: интервал в часах (0 — выключить) и сколько копий хранить
# DB_BACKUP_INTERVAL_HOURS=6
# DB_BACKUP_KEEP=7
# DB_BACKUP_DIR=./data/backups

# TTL кэша настроек в миллисекундах (0 — выключить кэш)
# SETTINGS_CACHE_TTL_MS=5000

# --- Веб-панель модератора (Discord OAuth2 + REST API + SPA) -----------------
# Включается только при WEB_ENABLED=true; тогда обязательны
# DISCORD_CLIENT_ID и DISCORD_CLIENT_SECRET.
WEB_ENABLED=false
WEB_PORT=3000
WEB_HOST=127.0.0.1

# Публичный адрес панели. Используется для OAuth2 redirect и проверки Origin.
# В Developer Portal -> OAuth2 -> Redirects добавьте: <WEB_PUBLIC_URL>/auth/callback
# WEB_PUBLIC_URL=http://127.0.0.1:3000

# OAuth2 Client Secret (Developer Portal -> OAuth2 -> Client Secret)
# DISCORD_CLIENT_SECRET=

# Время жизни сессии в часах (1..720). Сессии хранятся в SQLite,
# поэтому вход переживает перезапуск бота.
# WEB_SESSION_HOURS=168

# Каталог собранной React-панели. По умолчанию web/dist или dist/web/public.
# WEB_PANEL_DIR=web/dist

# Secure-куки. По умолчанию включаются автоматически для https:// в WEB_PUBLIC_URL.
# WEB_SECURE_COOKIES=true

# true — доверять X-Forwarded-For (только если панель стоит за своим reverse-proxy)
# WEB_TRUST_PROXY=false

# --- Постоянный адрес через Tailscale -----------------------------------------
# npm run tunnel            — показать tailnet-адрес и текущий serve
# npm run tunnel -- --apply — tailnet-only: tailscale serve --bg $WEB_PORT
# npm run tunnel -- --funnel — публично через Tailscale Funnel
# Вместо localhost укажите адрес узла:
# WEB_PUBLIC_URL=https://<host>.<tailnet>.ts.net
# WEB_TRUST_PROXY=true
# Redirect в Developer Portal: <WEB_PUBLIC_URL>/auth/callback

# --- Проверки при старте ------------------------------------------------------
# При запуске бот проверяет Node.js, интенты, БД, бэкапы, веб-панель, команды и
# права на каждом сервере. Отчёт печатается в консоль.
# STARTUP_CHECKS=false   — отключить отчёт
# STARTUP_STRICT=true    — завершать процесс, если проверки нашли ошибки
