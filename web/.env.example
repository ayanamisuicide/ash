# Адрес существующего HTTP-сервера бота (src/web).
# Vite проксирует /api/* и /auth/* на этот origin в dev-режиме.
# Если не задан, порт берётся из корневого .env (WEB_PORT).
# BOT_API_ORIGIN=http://127.0.0.1:8080

# Необязательно: префикс API, если панель и бот живут на разных origin.
# VITE_API_BASE_URL=https://bot.example.com

# Для локального OAuth в .env бота:
# WEB_PUBLIC_URL=http://127.0.0.1:5173
